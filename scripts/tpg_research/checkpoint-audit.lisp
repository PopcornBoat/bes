(require :asdf)
(asdf:load-system :cl-tpg)
(in-package :cl-tpg)

(defun audit-read (file)
  (with-open-file (in file)
    (with-standard-io-syntax (let ((*read-eval* nil)) (read in)))))

(defun audit-save (file data)
  (with-open-file (out file :direction :output :if-exists :error)
    (with-standard-io-syntax
      (let ((*print-circle* t) (*print-pretty* nil))
        (write data :stream out) (terpri out)))))

(defun audit-walk (team function)
  (let ((seen (make-hash-table :test #'equal)))
    (labels ((visit (saved)
               (let ((id (getf saved :id)))
                 (when (eq :already-serialized (getf saved :type))
                   (assert (gethash id seen))
                   (return-from visit nil))
                 (assert (not (gethash id seen)))
                 (setf (gethash id seen) t)
                 (funcall function saved)
                 (dolist (learner (getf saved :learners))
                   (let ((action (getf learner :action)))
                     (when (eq (getf action :type) :reference)
                       (visit (getf action :action))))))))
      (visit team))))

(defun audit-bounded-instruction-p (instruction)
  ;; The evaluator clips registers to +/-1000. The exported policies consume
  ;; finite categorical inputs. Preserve operations that could raise a trap
  ;; even when their destination never reaches the bid.
  (and (member (instruction-op instruction) '(:add :sub :mul :max :eq))
       (loop for (kind value) in
               (list (list (instruction-src1-type instruction) (instruction-src1-val instruction))
                     (list (instruction-src2-type instruction) (instruction-src2-val instruction)))
             always (or (member kind '(:reg :obs :ror))
                        (and (eq kind :const) (<= (abs value) 1000000d0))))))

(defun audit-live-indices (program)
  (let* ((instructions (program-instructions program))
         (live (make-array +num-registers+ :element-type 'bit :initial-element 0))
         (kept nil))
    (setf (sbit live +bid-register+) 1)
    (loop for i downfrom (1- (length instructions)) to 0
          for instruction = (aref instructions i)
          for dest = (instruction-dest instruction)
          when (or (= 1 (sbit live dest)) (not (audit-bounded-instruction-p instruction)))
          do (setf (sbit live dest) 0)
             (flet ((source (type value)
                      (when (eq type :reg) (setf (sbit live (truncate value)) 1))))
               (source (instruction-src1-type instruction) (instruction-src1-val instruction))
               (when (= (instruction-arity instruction) 2)
                 (source (instruction-src2-type instruction) (instruction-src2-val instruction))))
             (push i kept))
    kept))

(defun audit-atomic (value classifier)
  (if classifier
      (format nil "class=~D" value)
      (multiple-value-bind (target response)
          (values (getf (rest value) :target) (getf (rest value) :response))
        (assert (and (integerp target) (integerp response)) () "Unsupported atomic action ~S" value)
        (format nil "~D:~D" target response))))

(defun audit-tsv (stream &rest columns)
  (format stream "~{~A~^~C~}~%" (loop for (item . rest) on columns
                                     collect item when rest collect #\Tab)))

(defun audit-classifier-p (data)
  (eq :cage2-post-opening-opponent-classifier (getf data :fitness-evaluation-protocol)))

(defun audit-contract (data)
  (assert (not (getf data :recurrent-policy-enabled)))
  (assert (not (getf data :hamming-space-enabled)))
  (unless (audit-classifier-p data)
    (assert (eq :target-response-36 (getf data :terminal-action-format))))
  (assert (typep (getf data :num-observations) '(integer 1 199))))

(defun audit-prune (input output table)
  (let* ((data (audit-read input))
         (root (getf data :team)))
    (audit-contract data)
    (with-open-file (out table :direction :output :if-exists :error)
      (audit-tsv out "team" "learner" "saved_learner" "kind" "target"
                 "stored" "structural_live" "kept" "removed_indices")
      (audit-walk
       root
       (lambda (team)
         (loop with id = (getf team :id)
               for learner in (getf team :learners)
               for i from 0
               for action = (getf learner :action)
               for reference = (eq (getf action :type) :reference)
               for saved-program = (getf learner :program)
               for program = (deserialize-program saved-program)
               for counts = (analyze-program-effective-code program)
               for keep = (audit-live-indices program)
               for old = (getf saved-program :instructions)
               for removed = (loop for j below (length old) unless (member j keep) collect j)
               do (audit-tsv out id (format nil "~A/~D" id i) (getf learner :id)
                             (if reference "team" "action")
                             (if reference (getf (getf action :action) :id)
                                 (audit-atomic (getf action :action) (audit-classifier-p data)))
                             (length old) (getf counts :effective-instruction-count) (length keep)
                             (format nil "~{~D~^,~}" removed))
                  (setf (getf (getf learner :program) :instructions)
                        (loop for instruction in old for j from 0
                              when (member j keep) collect instruction))))))
    (audit-save output data)))

(defun audit-load (data)
  (let ((registry (make-hash-table :test #'equal))
        (team-ids (make-hash-table :test #'eq))
        (learner-ids (make-hash-table :test #'eq)))
    (let ((root (deserialize-team (getf data :team) registry)))
      (ensure-team-observation-compatible root (getf data :num-observations))
      (audit-walk (getf data :team)
                  (lambda (saved)
                    (let* ((id (getf saved :id))
                           (live (gethash id registry)))
                      (assert live)
                      (setf (gethash live team-ids) id)
                      (assert (= (length (getf saved :learners)) (length (team-learners live))))
                      (loop for learner in (team-learners live) for ordinal from 0
                            do (setf (gethash learner learner-ids) (format nil "~A/~D" id ordinal))))))
      (values root team-ids learner-ids))))

(defun audit-proposals (root obs classifier team-ids learner-ids)
  ;; Replay actual bid execution and the ranked evaluator's stable, depth-first
  ;; Top-K search. Every replay compares its results against the production entry
  ;; point. Store paths when the terminal is first emitted, before deduplication
  ;; can allow a later copy of the same semantic action to claim the path.
  (let ((cache (make-hash-table :test #'eq))
        (seen (make-hash-table :test #'equal))
        (evaluated nil) (candidates nil)
        (limit (if classifier 1 +semantic-ranking-limit+)))
    (labels ((ranking (team)
               (or (gethash team cache)
                   (progn
                     (push (gethash team team-ids) evaluated)
                     (setf (gethash team cache)
                           (stable-sort
                            (loop for learner in (team-learners team)
                                  collect (multiple-value-bind (value registers) (bid learner obs)
                                            (list learner value registers)))
                            #'> :key #'second)))))
             (visit (team trail selected depth)
               (unless (or (>= (length candidates) limit) (>= depth +max-team-traversal-depth+)
                           (member team trail :test #'eq))
                 (loop for (learner nil registers) in (ranking team)
                       for action = (learner-action learner)
                       for payload = (action-action action)
                       for path = (cons (gethash learner learner-ids) selected)
                       until (>= (length candidates) limit)
                       do (if (eq :reference (action-type action))
                              (visit payload (cons team trail) path (1+ depth))
                              (let ((key (if classifier payload
                                             (semantic-action-category-pair
                                              (make-semantic-action-from-terminal payload registers)))))
                                (unless (gethash key seen)
                                  (setf (gethash key seen) t)
                                  (push (list key (reverse path)) candidates))))))))
      (visit root nil nil 0)
      (values (reverse candidates) (reverse evaluated) cache))))

(defun audit-semantic-key (key)
  (if (integerp key) (format nil "class=~D" key)
      (format nil "~D:~D" (first key) (second key))))

(defun audit-replay (original pruned contexts output)
  (let* ((base (audit-read original)) (copy (audit-read pruned))
         (classifier (audit-classifier-p base))
         (*teams* nil)
         (*team-id-generator* (make-counter))
         (*learner-id-generator* (make-counter))
         (*cached-island-id* 0)
         (*recurrent-policy-enabled* nil)
         (*policy-episode-registers* nil)
         (*hamming-space-enabled* nil)
         (*num-observations* (getf base :num-observations))
         (*factored-actions-enabled* (not classifier))
         (*terminal-action-format* (getf base :terminal-action-format))
         (*instruction-set-profile* (getf base :instruction-set-profile))
         (*read-only-register-profile* (getf base :read-only-register-profile))
         (*decoy-order-mode* :fixed)
         (controllers (make-hash-table :test #'equal))
         (verified-obs (make-hash-table :test #'equal)))
    (audit-contract base) (audit-contract copy)
    (multiple-value-bind (team tids lids) (audit-load base)
      (multiple-value-bind (pruned-team ptids plids) (audit-load copy)
        (with-open-file (in contexts)
          (let ((*read-eval* nil))
            (with-open-file (out output :direction :output :if-exists :error)
              (audit-tsv out "id" "evaluated_teams" "ranking" "paths" "rank" "concrete" "resolution")
              (loop for context = (read in nil nil) while context
                    do (destructuring-bind (id raw mask profile mode) context
                         (let* ((obs (map '(simple-array double-float (*))
                                          (lambda (c) (coerce (digit-char-p c) 'double-float)) raw))
                                (entry
                                  (or (gethash raw verified-obs)
                                      (setf (gethash raw verified-obs)
                                            (multiple-value-bind (paths visited bids)
                                                (audit-proposals team obs classifier tids lids)
                                              (multiple-value-bind (new-paths new-visited new-bids)
                                                  (audit-proposals pruned-team obs classifier ptids plids)
                                                (assert (equal paths new-paths))
                                                (assert (equal visited new-visited))
                                                (let ((scores (make-hash-table :test #'equal)))
                                                  (maphash (lambda (tm learners)
                                                             (declare (ignore tm))
                                                             (dolist (item learners)
                                                               (setf (gethash (gethash (first item) lids) scores)
                                                                     (second item))))
                                                           bids)
                                                  (maphash (lambda (tm learners)
                                                             (declare (ignore tm))
                                                             (dolist (item learners)
                                                               (assert (= (second item)
                                                                          (gethash (gethash (first item) plids)
                                                                                   scores)))))
                                                           new-bids)))
                                              (if classifier
                                                  (progn
                                                    (assert (= (caar paths) (execute-team team obs)))
                                                    (assert (= (caar paths) (execute-team pruned-team obs))))
                                                  (dolist (root (list team pruned-team))
                                                    (assert (equal (mapcar #'first paths)
                                                                   (mapcar #'semantic-action-category-pair
                                                                           (execute-team-semantic-ranked root obs))))))
                                              (list paths visited)))))
                                (paths (first entry))
                                (controller (unless classifier
                                              (or (gethash profile controllers)
                                                  (setf (gethash profile controllers)
                                                        (make-cage2-controller :decoy-order-profile profile)))))
                                (decision (when (and controller mask)
                                            (setf (cage2-controller-decoy-mask controller) mask)
                                            (let ((*cage2-decoy-resolution* mode))
                                              (cage2-controller-resolve-pair-ranking
                                               controller (mapcar #'first paths)))))
                                (rank (when decision (cage2-controller-decision-rank decision)))
                                (kind (cond ((not decision) "unobserved")
                                            ((or (cage2-controller-decision-fallback-p decision)
                                                 (not (integerp rank))) "controller-only")
                                            ((not (equal (first (nth rank paths))
                                                         (semantic-action-category-pair
                                                          (cage2-controller-decision-semantic-action decision))))
                                             "controller-override")
                                            (t "candidate"))))
                           (audit-tsv out id (format nil "~{~A~^,~}" (second entry))
                                      (format nil "~{~A~^,~}" (mapcar (lambda (p) (audit-semantic-key (first p))) paths))
                                      (format nil "~{~{~A~^,~}~^;~}" (mapcar #'second paths))
                                      (or rank "-")
                                      (if decision (cage2-controller-decision-concrete-action decision) "-")
                                      kind)))))))))))

(defun audit-observation-uses (program indices)
  (let ((instructions (program-instructions program)))
    (loop for i in indices
          for instruction = (aref instructions i)
          append (remove nil
                         (list (when (eq (instruction-src1-type instruction) :obs)
                                 (truncate (instruction-src1-val instruction)))
                               (when (and (= (instruction-arity instruction) 2)
                                          (eq (instruction-src2-type instruction) :obs))
                                 (truncate (instruction-src2-val instruction))))))))

(defun audit-observation-sources (file output)
  (let ((data (audit-read file)))
    (audit-contract data)
    (with-open-file (out output :direction :output :if-exists :error)
      (audit-tsv out "team" "learner" "original_reads" "retained_reads" "bid_live_reads")
      (audit-walk (getf data :team)
        (lambda (team)
          (loop for saved in (getf team :learners) for slot from 0
                for program = (deserialize-program (getf saved :program))
                for bid = (getf (analyze-program-effective-code program) :effective-indices)
                for keep = (audit-live-indices program)
                for all = (loop for i below (length (program-instructions program)) collect i)
                do (flet ((column (indices)
                            (format nil "~{~D~^,~}" (audit-observation-uses program indices))))
                     (audit-tsv out (getf team :id) (format nil "~A/~D" (getf team :id) slot)
                                (column all) (column keep) (column bid)))))))))

(destructuring-bind (mode &rest args) (uiop:command-line-arguments)
  (let ((*cached-island-id* 0))
    (ecase (intern (string-upcase mode) :keyword)
      (:prune (apply #'audit-prune args))
      (:replay (apply #'audit-replay args))
      (:observation-sources (apply #'audit-observation-sources args)))))
