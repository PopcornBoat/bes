(in-package :cl-tpg)

(defun torch-training-episode (controller seed choice-seed phase)
  (py4cl2:pycall "_continuous_seed")
  (let ((env (cl-gym::make (cage2-validation-environment-name "b_line" 100)))
        (total 0d0))
    (unwind-protect
      (progn
        (cl-gym::configure-cage2-controller-option-orders env controller)
        (cage2-controller-reset controller)
        (py4cl2:pycall "torch_terminal_actor.begin" seed phase choice-seed)
        (let ((raw (cl-gym::reset env seed)))
          (dotimes (step 100)
            (let* ((obs (cage2-controller-observe controller raw))
                   (mask (cage2-controller-decoy-mask controller))
                   (ranking
                    (if (< step 3)
                        (let ((opening (aref +cage2-fixed-opening-rankings+ step)))
                          (py4cl2:pycall "torch_terminal_actor.opening" obs mask opening)
                          opening)
                        (map 'list (lambda (pair) (map 'list #'identity pair))
                             (py4cl2:pycall "torch_terminal_actor.act" obs mask))))
                   (decision (cage2-controller-resolve-pair-ranking controller ranking))
                   (pair (semantic-action-category-pair
                          (cage2-controller-decision-semantic-action decision))))
              (multiple-value-bind (next reward terminated truncated info)
                  (cl-gym::step env (cl-gym::controller-decision->cage2-input decision))
                (cl-gym::commit-controller-step controller decision info)
                (py4cl2:pycall "torch_terminal_actor.feedback" reward (first pair) (second pair)
                              (cage2-controller-decision-concrete-action decision)
                              (py4cl2:pycall "_continuous_loss" env reward (if (= (second pair) 2) 1 0)))
                (incf total reward)
                (setf raw next)
                (when (or terminated truncated) (assert (= step 99)))))))
        (assert (< (abs (- total (py4cl2:pycall "torch_terminal_actor.finish"))) 1d-7)))
      (py4cl2:pymethod env "close"))
    total))

(defun torch-run-training (checkpoint graph parameters plan-file output mode seed scripts)
  (continuous-call "b_line"
   (lambda ()
     (py4cl2:pyexec
      (format nil "import sys~%sys.path.insert(0,~S)~%import torch_terminal_actor~%import gymnasium as gym~%import cage2_bridge~%import random~%import numpy as np~%import json~%def _continuous_seed():~%    random.seed(153)~%    np.random.seed(153)~%def _continuous_loss(env, reward, restore):~%    parts=env.unwrapped.env.get_reward_breakdown('Blue')~%    assert abs(sum(sum(v) for v in parts.values())-restore-reward)<1e-7~%    return json.dumps(parts,sort_keys=True,separators=(',',':'))" scripts))
     (py4cl2:pycall "torch_terminal_actor.initialize" graph parameters output mode seed)
     (let* ((plan (continuous-read plan-file))
            (controller (make-cage2-controller))
            (warm (getf plan :warmup))
            (batches (getf plan :batches))
            (checks (getf plan :checks)))
       (loop for (episode choice) in warm for i from 1 do
         (format t "~&TORCH_WARMUP ~D return=~,4F~%" i
                 (torch-training-episode controller episode choice "warmup"))
         (finish-output))
       (py4cl2:pycall "torch_terminal_actor.warmup")
       (loop for batch in batches for update from 1 do
         (loop for (episode choice) in batch for i from 1 do
           (format t "~&TORCH_EPISODE update=~D episode=~D return=~,4F~%" update i
                   (torch-training-episode controller episode choice "training"))
           (finish-output))
         (format t "~&TORCH_UPDATE ~A~%" (py4cl2:pycall "torch_terminal_actor.update"))
         (finish-output)
         (when (and (string= mode "learn") (assoc update checks))
           (let* ((folder (merge-pathnames (format nil "snapshot-~2,'0D/" update) output))
                  (request (merge-pathnames "patch.sexp" folder))
                  (arms (merge-pathnames "arms.sexp" folder))
                  (cases (merge-pathnames "cases.sexp" folder)))
             (ensure-directories-exist request)
             (py4cl2:pycall "torch_terminal_actor.export" (namestring request))
             (numeric-policy-build "b_line" checkpoint request folder)
             (with-open-file (f arms :direction :output :if-exists :error)
               (prin1 (list (list "baseline" checkpoint)
                            (list "candidate" (namestring (merge-pathnames "candidate.lisp" folder)))) f))
             (with-open-file (f cases :direction :output :if-exists :error)
               (prin1 (mapcar (lambda (episode) (list 100 episode)) (cdr (assoc update checks))) f))
             (continuous-evaluate "b_line" (namestring arms) (namestring cases) folder)
             (format t "~&TORCH_HARD_CHECKPOINT update=~D completed~%" update)
             (finish-output))))
       (let ((folder (merge-pathnames "final/" output)))
         (ensure-directories-exist (merge-pathnames "patch.sexp" folder))
         (py4cl2:pycall "torch_terminal_actor.export"
                       (namestring (merge-pathnames "patch.sexp" folder)))
         (numeric-policy-build "b_line" checkpoint (merge-pathnames "patch.sexp" folder) folder))
       (format t "~&TORCH_TRAINING_DONE mode=~A~%" mode)
       (finish-output)))))

