#!/usr/bin/env bash
set -euo pipefail

repo=/home/hardison/bes
python=/home/hardison/venv-base/cage2_bridge/.venv/bin/python
sender="$repo/scripts/bes-send-command.py"

usage() {
  echo "Usage: $0 submit REQUEST.sexp | stop | raw LISP-FORM" >&2
  exit 2
}

[[ -x "$python" ]] || { echo "Missing bridge Python: $python" >&2; exit 1; }
[[ -f "$sender" ]] || { echo "Missing command sender: $sender" >&2; exit 1; }

case "${1:-}" in
  submit)
    [[ $# -eq 2 ]] || usage
    request=$2
    [[ "$request" = /* ]] || request="$repo/$request"
    [[ -f "$request" ]] || { echo "Missing request file: $request" >&2; exit 1; }
    exec "$python" "$sender" --file "$request"
    ;;
  stop)
    [[ $# -eq 1 ]] || usage
    exec "$python" "$sender" --message '(:type :stop-search)'
    ;;
  raw)
    [[ $# -eq 2 ]] || usage
    exec "$python" "$sender" --message "$2"
    ;;
  *) usage ;;
esac

