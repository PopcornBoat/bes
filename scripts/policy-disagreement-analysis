#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 3 || $# -gt 4 ]]; then
  echo "Usage: $0 EVOLVED_CHECKPOINT COMPILED_CHECKPOINT OUTPUT_DIRECTORY [SEEDS]" >&2
  echo "SEEDS defaults to 153,42,2026." >&2
  exit 2
fi

evolved_checkpoint=$1
compiled_checkpoint=$2
output_directory=$3
seeds=${4:-153,42,2026}
repo=/home/hardison/bes
bridge_bin=/home/hardison/venv-base/cage2_bridge/.venv/bin

mkdir -p "$output_directory"
sha256sum "$evolved_checkpoint" "$compiled_checkpoint" \
  > "$output_directory/input-sha256.txt"

cd "$repo"
env \
  "PATH=$bridge_bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
  'CL_SOURCE_REGISTRY=(:source-registry (:tree "/home/hardison/bes/") :ignore-inherited-configuration)' \
  "POLICY_ANALYSIS_EVOLVED_CHECKPOINT=$evolved_checkpoint" \
  "POLICY_ANALYSIS_COMPILED_CHECKPOINT=$compiled_checkpoint" \
  "POLICY_ANALYSIS_OUTPUT_DIRECTORY=$output_directory" \
  "POLICY_ANALYSIS_SEEDS=$seeds" \
  /usr/bin/sbcl \
    --dynamic-space-size 4096 \
    --non-interactive \
    --eval '(require :asdf)' \
    --eval '(asdf:load-system :cl-tpg)' \
    --eval '(cl-tpg::run-policy-disagreement-analysis-from-environment)'
