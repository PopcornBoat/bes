#!/usr/bin/env bash
set -euo pipefail
if [[ $# -ne 5 ]]; then
  echo "Usage: $0 CHECKPOINT ENVIRONMENT MANIFEST SEED_ROOT OUTPUT_DIRECTORY" >&2
  exit 2
fi
repo=/home/hardison/bes-artifacts/worktrees/structural-opportunity-audit
checkpoint=$1 environment=$2 manifest=$3 seed_root=$4 output=$5
mkdir -p "$output"
export PATH=/home/hardison/venv-base/cage2_bridge/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export CL_SOURCE_REGISTRY='(:source-registry (:directory "/home/hardison/bes-artifacts/worktrees/structural-opportunity-audit/") :ignore-inherited-configuration)'
export SWEEP_CHECKPOINT="$checkpoint" SWEEP_ENVIRONMENT="$environment"
export SWEEP_MANIFEST="$manifest" SWEEP_SEED_ROOT="$seed_root"
export SWEEP_OUTPUT="$output/events.tsv"
sha256sum "$checkpoint" "$manifest" "$repo/response-sweep.lisp" \
  "$repo/scripts/analyze-response-sweep.py" \
  "$repo/experiments/meander-v8-gap-screen.md" > "$output/input-sha256.txt"
cd "$repo"
/usr/bin/sbcl --dynamic-space-size 4096 --non-interactive \
  --eval '(require :asdf)' \
  --eval '(asdf:load-system :cl-tpg)' \
  --load official-counterfactual-pilot.lisp \
  --load matched-counterfactual-screen.lisp \
  --load response-sweep.lisp \
  --eval '(cl-tpg::run-response-sweep
            (uiop:getenv "SWEEP_CHECKPOINT")
            (uiop:getenv "SWEEP_MANIFEST")
            (uiop:getenv "SWEEP_OUTPUT")
            :seed-root (parse-integer (uiop:getenv "SWEEP_SEED_ROOT"))
            :environment-name (uiop:getenv "SWEEP_ENVIRONMENT"))'
python3 scripts/analyze-response-sweep.py "$output" "$seed_root"
