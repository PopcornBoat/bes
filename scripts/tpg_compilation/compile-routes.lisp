(in-package :cl-tpg)

(defun read-ranked-data (path)
  (with-open-file (stream path)
    (with-standard-io-syntax
      (let ((*read-eval* nil))
        (prog1 (read stream)
          (assert (eq :eof (read stream nil :eof))))))))

(defun rank-table (rows shape)
  (let ((table (make-hash-table :test #'equal)))
    (dolist (row rows table)
      (destructuring-bind (obs ranking)
          (ecase shape
            (:observation (destructuring-bind (obs ranking) row (list obs ranking)))
            (:legacy-counts
             (destructuring-bind (obs counts ranking) row
               (assert (and (= (length counts) 9) (every #'integerp counts)))
               (list obs ranking))))
        (assert (and (stringp obs) (= (length obs) 62)
                     (every (lambda (c) (find c "01")) (subseq obs 0 52))
                     (every (lambda (c) (find c "012")) (subseq obs 52))))
        (assert (= 8 (length ranking) (length (remove-duplicates ranking :test #'equal))))
        (dolist (pair ranking)
          (destructuring-bind (target response) pair
            (assert (and (find target *semantic-36-targets*) (integerp response) (<= 0 response 3)))))
        (multiple-value-bind (previous present) (gethash obs table)
          (when (and present (not (equal ranking previous)))
            (error "Ranking depends on state outside the 62-input contract for ~A" obs)))
        (setf (gethash obs table) ranking)))))

(defun protected-meander-context-p (obs original)
  (and (string= "1101" obs :start2 4 :end2 8)
       (string= "0011" obs :start2 40 :end2 44)
       (equal '(2 2) (first original))))

(defun compile-route-catalogue (source catalogue output profile shape policy contexts)
  (let* ((*num-observations* 62) (*num-actions* 36)
         (*factored-actions-enabled* t)
         (*terminal-action-format* :target-response-36)
         (*recurrent-policy-enabled* nil)
         (*policy-episode-registers* nil)
         (*hamming-space-enabled* nil)
         (*cage2-opening-mode* :fixed)
         (*decoy-order-mode* :fixed)
         (*cage2-decoy-resolution* :ranked-decoy-hosts)
         (*cage2-controller-decoy-order-profile* profile)
         (*cached-island-id* 0)
         (*teams* nil)
         (*team-id-generator* (make-counter))
         (*learner-id-generator* (make-counter))
         (expert (load-dispatch-expert source profile))
         (*instruction-set-profile* (dispatch-expert-instruction-profile expert))
         (*read-only-register-profile* (dispatch-expert-register-profile expert))
         (base (dispatch-expert-team expert))
         (rules (rank-table (read-ranked-data catalogue) shape))
         (observations (loop for obs being the hash-keys in rules collect obs))
         (rows nil)
         (protected 0))
    (multiple-value-bind (depth support) (native-graph-shape base)
      (declare (ignore depth))
      (assert (>= support +semantic-ranking-limit+)))
    (dolist (obs observations)
      (if (and (eq policy :meander-v15)
               (protected-meander-context-p obs (native-ranking base (native-observation obs))))
          (progn (remhash obs rules) (incf protected))
          (push (cons obs (gethash obs rules)) rows)))
    (assert rows () "Catalogue has no compilable observation rules.")
    (setf (team-type base) :internal
          rows (sort rows #'string< :key #'car))
    (multiple-value-bind (compiled leaves)
        (native-compile-decision-tree rows base)
      (ensure-team-observation-compatible compiled 62)
      (native-graph-shape compiled)
      (multiple-value-bind (teams learners instructions max-team max-program)
          (team-complexity compiled)
        (declare (ignore teams learners instructions))
        (assert (<= max-team 32))
        (assert (<= max-program 256)))
      (write-best-team-checkpoint compiled nil output
                                  :fitness-evaluation-protocol :exact-ranked-graph-compilation
                                  :num-observations 62 :decoy-order-mode :fixed
                                  :cage2-opening-mode :fixed :recurrent-policy-enabled nil)
      (let ((reloaded (load-best-team output))
            (context-count 0)
            (controller (make-cage2-controller :decoy-order-profile profile)))
        (labels ((check (obs &optional mask)
                   (let* ((input (native-observation obs))
                          (expected (or (gethash obs rules) (native-ranking base input)))
                          (actual (native-ranking reloaded input)))
                     (assert (= (length expected) +semantic-ranking-limit+))
                     (assert (equal expected actual) () "Ranking mismatch on ~A." obs)
                     (when mask
                       (setf (cage2-controller-decoy-mask controller) mask)
                       (flet ((delivery (ranking)
                                (let ((result (cage2-controller-resolve-pair-ranking controller ranking)))
                                  (list (cage2-controller-decision-concrete-action result)
                                        (cage2-controller-decision-rank result)
                                        (cage2-controller-decision-option result)
                                        (cage2-controller-decision-fallback-p result)))))
                         (assert (equal (delivery expected) (delivery actual)))
                         (assert (= mask (cage2-controller-decoy-mask controller))))
                       (incf context-count)))))
          (dolist (obs observations) (check obs))
          (when contexts
            (dolist (cohort (read-ranked-data contexts))
              (destructuring-bind (name pairs) cohort
                (declare (ignore name))
                (dolist (pair pairs) (apply #'check pair))))))
        (format t "~&COMPILE_PASS rules=~D shared_leaves=~D protected=~D archive_contexts=~D~%"
                (length rows) leaves protected context-count)))))
