(in-package :cl-tpg)

(defun extreme-read (path)
  (with-open-file (in path)
    (with-standard-io-syntax
      (let ((*read-eval* nil))
        (read in)))))

(defun extreme-install-orders (controller orders)
  "Keep the Controller's whitelist and replace only each host's option order."
  (let ((schedule (cage2-controller-decoy-schedule controller)))
    (loop for host from 1 for order in orders
          for available = (loop for (h option) in schedule when (= h host) collect option)
          unless (equal (sort (copy-list order) #'<) (sort available #'<))
            do (error "Decoy whitelist changed for host ~D: ~S versus ~S." host order available))
    (let* ((queues (map 'vector #'copy-list (cons nil orders)))
           (updated (loop for (host) in schedule collect (list host (pop (aref queues host))))))
      (setf (cage2-controller-decoy-schedule controller) updated
            (cage2-controller-option-orders controller)
            (cage2-cardiff-bridge-orders (cage2-controller-agreement controller) updated))))
  controller)

(defun extreme-ranking (expert input)
  (let ((*instruction-set-profile* (dispatch-expert-instruction-profile expert))
        (*read-only-register-profile* (dispatch-expert-register-profile expert)))
    (execute-team-semantic-ranked (dispatch-expert-team expert) input)))

(defun extreme-pair-label (semantic)
  (destructuring-bind (host response) (semantic-action-category-pair semantic)
    (format nil "~D:~D" host response)))

(defun extreme-candidate-swap (controller ranking current)
  ;; Resolve speculatively against the pre-step mask. The resolver is pure.
  ;; A locally unchanged concrete action has no effect on the trajectory.
  (when (= (length ranking) +semantic-ranking-limit+)
    (let* ((changed (list* (second ranking) (first ranking) (cddr ranking)))
           (decision (cage2-controller-resolve-ranking controller changed)))
      (unless (= (cage2-controller-decision-concrete-action current)
                 (cage2-controller-decision-concrete-action decision))
        changed))))

(defun full-validation-agent-server (router-file bline-file meander-file)
  "Route the official agent through immutable TPG graphs and the unchanged Controller resolver."
  (let* ((*cached-island-id* 0)
         (*teams* nil)
         (*team-id-generator* (make-counter))
         (*learner-id-generator* (make-counter))
         (*num-observations* 62)
         (*num-actions* 36)
         (*factored-actions-enabled* t)
         (*terminal-action-format* :target-response-36)
         (*cage2-opening-mode* :fixed)
         (*decoy-order-mode* :fixed)
         (*cage2-decoy-resolution* :ranked-decoy-hosts)
         (*recurrent-policy-enabled* nil)
         (*policy-episode-registers* nil)
         (*hamming-space-enabled* nil)
         (orders (extreme-read (uiop:getenv "BES_EXTREME_ORDERS")))
         (trace-p (equal (uiop:getenv "BES_EXTREME_TRACE") "1"))
         (router (load-post-opening-router router-file))
         (bline (load-dispatch-expert bline-file :bline-cardiff-global))
         (meander (load-dispatch-expert meander-file :meander-cardiff-global))
         (controller (make-cage2-controller :decoy-order-profile :heuristic))
         (expert nil)
         (pending nil))
    (assert (= 10 (length orders)))
    (dolist (validated (list bline meander))
      (extreme-install-orders (dispatch-expert-controller-template validated) orders))
    (labels ((reply (control &rest values)
               (write-string "AGENT " *standard-output*)
               (apply #'format *standard-output* control values)
               (terpri) (finish-output))
             (choose (raw)
               (assert (not pending))
               (assert (and (= (length raw) 52) (every (lambda (c) (find c "01")) raw)))
               (let* ((obs (map 'vector #'digit-char-p raw))
                      (input (cage2-controller-observe controller obs))
                      (step (cage2-controller-step controller))
                      (route (post-opening-route router controller input)))
                 (when (= step +post-opening-router-decision+)
                   (setf expert (ecase route (:b-line bline) (:meander meander) (:sleep nil)))
                   (when expert
                     (let ((template (dispatch-expert-controller-template expert)))
                       (setf (cage2-controller-decoy-order-profile controller)
                             (cage2-controller-decoy-order-profile template)
                             (cage2-controller-option-orders controller)
                             (cage2-controller-option-orders template)
                             (cage2-controller-decoy-schedule controller)
                             (cage2-controller-decoy-schedule template)))))
                 (let* ((ranked (when expert (extreme-ranking expert input)))
                        (decision
                          (cond ((eq route :sleep) :sleep)
                                ((< step +post-opening-router-decision+)
                                 (cage2-controller-resolve-pair-ranking
                                  controller (aref +cage2-fixed-opening-rankings+ step)))
                                (t (cage2-controller-resolve-ranking controller ranked))))
                        (top (if ranked (extreme-pair-label (first ranked)) "-"))
                        (candidate (when (and trace-p ranked)
                                     (extreme-candidate-swap controller ranked decision))))
                   (setf pending decision)
                   (reply "~D ~(~A~) ~A ~A ~A ~A"
                          (if (eq decision :sleep) 0
                              (cage2-controller-decision-concrete-action decision))
                          (or route :opening) top top
                          (if candidate
                              (map 'string (lambda (value) (digit-char (truncate value))) input)
                              "-")
                          (if candidate
                              (format nil "~{~A~^,~}" (mapcar #'extreme-pair-label candidate))
                              "-")))))
             (commit (action)
               (assert pending)
               (if (eq pending :sleep)
                   (progn (assert (zerop action)) (incf (cage2-controller-step controller)))
                   (cage2-controller-commit-decision controller pending action))
               (setf pending nil)
               (reply "ok")))
      (reply "ready")
      (loop for line = (read-line *standard-input* nil) while line
            do (cond ((string= line "quit") (return))
                     ((string= line "reset")
                      (assert (not pending))
                      (setf controller (make-cage2-controller :decoy-order-profile :heuristic)
                            expert nil)
                      (reset-post-opening-router router)
                      (reply "ok"))
                     ((and (> (length line) 4) (string= "obs " line :end2 4))
                      (choose (subseq line 4)))
                     ((and (> (length line) 7) (string= "commit " line :end2 7))
                      (commit (parse-integer line :start 7)))
                     (t (error "Unexpected extreme optimizer command: ~S." line)))))))

(defun extreme-prove-fallback (root)
  "Require eight reachable categories and enough depth for a graph-only selector."
  (let ((active (make-hash-table :test #'eq))
        (memo (make-hash-table :test #'eq))
        (categories (make-hash-table :test #'equal)))
    (labels ((depth (team)
               (when (gethash team active)
                 (return-from extreme-prove-fallback :cyclic-fallback))
               (or (gethash team memo)
                   (let ((deepest 1))
                     (setf (gethash team active) t)
                     (dolist (learner (team-learners team))
                       (let* ((action (learner-action learner)) (payload (action-action action)))
                         (ecase (action-type action)
                           (:reference (setf deepest (max deepest (1+ (depth payload)))))
                           (:atomic
                            (assert (target-response-36-action-p payload))
                            (setf (gethash
                                   (semantic-action-category-pair
                                    (make-semantic-action-from-terminal payload nil)) categories) t)))))
                     (remhash team active)
                     (setf (gethash team memo) deepest)))))
      (let ((max-depth (depth root)))
        (cond ((> (1+ max-depth) +max-team-traversal-depth+) :fallback-depth)
              ((< (hash-table-count categories) +semantic-ranking-limit+) :short-fallback)
              (t nil))))))

(defun extreme-compile-ranked-edit (source request destination)
  "Add one exact observable context as native ranked TPG nodes."
  (destructuring-bind (role observation ranking) (extreme-read request)
    (let* ((*cached-island-id* 0)
           (*num-observations* 62) (*num-actions* 36)
           (*factored-actions-enabled* t)
           (*terminal-action-format* :target-response-36)
           (*cage2-opening-mode* :fixed) (*decoy-order-mode* :fixed)
           (*cage2-decoy-resolution* :ranked-decoy-hosts)
           (*recurrent-policy-enabled* nil) (*policy-episode-registers* nil)
           (*hamming-space-enabled* nil)
           (*teams* nil) (*team-id-generator* (make-counter)) (*learner-id-generator* (make-counter))
           (*cage2-controller-decoy-order-profile*
             (ecase role (:b-line :bline-cardiff-global) (:meander :meander-cardiff-global)))
           (expert (load-dispatch-expert source *cage2-controller-decoy-order-profile*))
           (*instruction-set-profile* (dispatch-expert-instruction-profile expert))
           (*read-only-register-profile* (dispatch-expert-register-profile expert))
           (base (dispatch-expert-team expert))
           (reason (extreme-prove-fallback base)))
      (when reason
        (format t "~&EXTREME_SKIP ~A~%" reason)
        (return-from extreme-compile-ranked-edit nil))
      (assert (and (stringp observation) (= (length observation) 62)
                   (every (lambda (c) (find c "012")) observation)))
      (assert (and (= (length ranking) +semantic-ranking-limit+)
                   (= (length (remove-duplicates ranking :test #'equal)) +semantic-ranking-limit+)))
      (let* ((input (post-opening-router-categories observation))
             (old (mapcar #'semantic-action-category-pair (execute-team-semantic-ranked base input))))
        (assert (equal ranking (list* (second old) (first old) (cddr old))))
        (let* ((terminal (native-ranked-terminal ranking))
               (root (native-binary-choice (native-exact-predicate observation) terminal base)))
          (setf (team-type root) :root)
          (setf (team-type base) :internal)
          (flet ((ranked (team obs)
                   (mapcar #'semantic-action-category-pair (execute-team-semantic-ranked team obs))))
            (assert (equal ranking (ranked root input)))
            (dotimes (i 62)
              (let ((neighbor (copy-seq input)))
                (setf (aref neighbor i) (if (zerop (aref neighbor i)) 1d0 0d0))
                (assert (equal (ranked base neighbor) (ranked root neighbor))))))
          (assert (not (probe-file destination)))
          (write-best-team-checkpoint root nil destination
                                      :fitness-evaluation-protocol :extreme-optimize-ranked-edit
                                      :num-observations 62 :decoy-order-mode :fixed
                                      :cage2-opening-mode :fixed :recurrent-policy-enabled nil)
          (format t "~&EXTREME_COMPILED~%"))))))
