(in-package :cl-tpg)

(defun numeric-policy-nodes (root)
  (let ((seen (make-hash-table :test #'eq)) (nodes nil))
    (labels ((visit (team)
               (unless (gethash team seen)
                 (setf (gethash team seen) t)
                 (push team nodes)
                 (dolist (learner (team-learners team))
                   (when (eq (action-type (learner-action learner)) :reference)
                     (visit (action-action (learner-action learner))))))))
      (visit root))
    (nreverse nodes)))

(defun numeric-constant-bid-p (instructions)
  (and (= (length instructions) 1)
       (let ((ins (aref instructions 0)))
         (and (= (instruction-dest ins) +bid-register+)
              (eq (instruction-op ins) :add)
              (eq (instruction-src1-type ins) :const)
              (eq (instruction-src2-type ins) :const)
              (zerop (instruction-src2-val ins))))))

(defun numeric-parameter-records (root)
  (let ((records nil) (id 0))
    (loop for node in (numeric-policy-nodes root) for ni from 0 do
      (loop for learner in (team-learners node) for li from 0 do
        (let* ((program (learner-program learner))
               (instructions (program-instructions program))
               (live (getf (analyze-program-effective-code program) :effective-mask))
               (direct (numeric-constant-bid-p instructions)))
          (loop for ins across instructions for ii from 0 do
            (loop for operand from 1 to (instruction-arity ins)
                  for type = (if (= operand 1) (instruction-src1-type ins) (instruction-src2-type ins))
                  for value = (if (= operand 1) (instruction-src1-val ins) (instruction-src2-val ins))
                  when (eq type :const) do
                    (let* ((kind (cond
                                   ((eq (instruction-op ins) :eq) "predicate-constant")
                                   ((zerop (sbit live ii)) "intron-constant")
                                   ((and direct (= operand 2)) "redundant-bid-zero")
                                   (direct "constant-bid")
                                   (t "arithmetic-constant")))
                           (eligible (member kind '("constant-bid" "arithmetic-constant") :test #'string=)))
                      (push (list id ni li ii operand value kind (if eligible 1 0)
                                  (max 0.05d0 (min 5d0 (* 0.1d0 (abs value)))))
                            records)
                      (incf id)))))))
    (nreverse records)))

(defun numeric-structure (root)
  "Erase non-EQ numeric values; frozen-coordinate equality is checked separately."
  (let* ((nodes (numeric-policy-nodes root))
         (index (make-hash-table :test #'eq))
         (eligible (make-hash-table :test #'equal)))
    (loop for node in nodes for i from 0 do (setf (gethash node index) i))
    (dolist (r (numeric-parameter-records root))
      (unless (string= (seventh r) "predicate-constant")
        (setf (gethash (subseq r 1 5) eligible) t)))
    (loop for node in nodes for ni from 0 collect
      (list ni (team-type node)
        (loop for learner in (team-learners node) for li from 0 collect
          (let ((action (learner-action learner)))
            (list
             (loop for ins across (program-instructions (learner-program learner))
                   for ii from 0 collect
                     (list (instruction-dest ins) (instruction-op ins) (instruction-arity ins)
                       (instruction-src1-type ins)
                       (if (gethash (list ni li ii 1) eligible) :numeric (instruction-src1-val ins))
                       (instruction-src2-type ins)
                       (if (gethash (list ni li ii 2) eligible) :numeric (instruction-src2-val ins))))
             (action-type action)
             (if (eq (action-type action) :reference)
                 (gethash (action-action action) index)
                 (serialize-atomic-action-value (action-action action))))))))))

(defun numeric-topology-depth (root)
  (let ((memo (make-hash-table :test #'eq)))
    (labels ((depth (node stack)
               (when (member node stack :test #'eq) (error "Frozen graph has a cycle."))
               (or (gethash node memo)
                   (setf (gethash node memo)
                         (1+ (loop for learner in (team-learners node)
                                   for action = (learner-action learner)
                                   when (eq (action-type action) :reference)
                                     maximize (depth (action-action action) (cons node stack)) into maximum
                                   finally (return (or maximum 0))))))))
      (let ((result (depth root nil)))
        (assert (<= result +max-team-traversal-depth+))
        result))))

(defun numeric-policy-export (opponent checkpoint output)
  (continuous-call opponent
   (lambda ()
     (let* ((root (continuous-load checkpoint))
            (depth (numeric-topology-depth root)))
       (with-open-file (f (merge-pathnames "topology.tsv" output) :direction :output :if-exists :error)
         (continuous-row f "max_depth" "teams" "learners")
         (continuous-row f depth (length (numeric-policy-nodes root))
                         (loop for node in (numeric-policy-nodes root) sum (length (team-learners node)))))
       (with-open-file (f (merge-pathnames "parameters.tsv" output) :direction :output :if-exists :error)
         (continuous-row f "id" "node" "learner" "instruction" "operand" "value" "kind" "eligible" "unit")
         (dolist (record (numeric-parameter-records root))
           (apply #'continuous-row f record)))
       (with-open-file (f (merge-pathnames "structure.sexp" output) :direction :output :if-exists :error)
         (let ((*print-pretty* nil))
           (prin1 (numeric-structure root) f)
           (terpri f)))))))

(defun numeric-policy-build (opponent checkpoint requests output)
  (continuous-call opponent
   (lambda ()
     (dolist (request (continuous-read requests))
       (destructuring-bind (name patch) request
         (let* ((root (continuous-load checkpoint))
                (before (numeric-structure root))
                (nodes (numeric-policy-nodes root))
                (records (coerce (numeric-parameter-records root) 'vector)))
           (dolist (change patch)
             (destructuring-bind (id value) change
               (destructuring-bind (rid ni li ii operand old kind eligible unit) (aref records id)
                 (declare (ignore rid old kind unit))
                 (assert (= eligible 1))
                 (let ((ins (aref (program-instructions
                                  (learner-program (nth li (team-learners (nth ni nodes))))) ii)))
                   (assert (and (realp value) (< (abs value) 1d6)))
                   (if (= operand 1)
                       (setf (instruction-src1-val ins) (coerce value 'double-float))
                       (setf (instruction-src2-val ins) (coerce value 'double-float)))))))
           (assert (equalp before (numeric-structure root)))
           (let ((path (merge-pathnames (format nil "~A.lisp" name) output)))
             (continuous-write root path opponent)
             (let ((restored (continuous-load path)))
               (assert (equalp before (numeric-structure restored)))
               (let ((actual (coerce (numeric-parameter-records restored) 'vector))
                     (updates (make-hash-table)))
                 (dolist (change patch) (setf (gethash (first change) updates) (second change)))
                 (assert (= (length actual) (length records)))
                 (loop for record across records for after across actual do
                   (assert (= (sixth after) (gethash (first record) updates (sixth record)))))))))
           (format t "~&BUILT ~A changed-parameters=~D~%" name (length patch))
           (finish-output))))))
