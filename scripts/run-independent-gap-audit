#!/usr/bin/env bash
set -euo pipefail
if [[ $# -ne 4 ]]; then
  echo "Usage: $0 CHECKPOINT ENVIRONMENT SEED_ROOT OUTPUT_DIRECTORY" >&2
  exit 2
fi
repo=/home/hardison/bes-artifacts/worktrees/structural-opportunity-audit
checkpoint=$1 environment=$2 seed_root=$3 output=$4
mkdir -p "$output"
export PATH=/home/hardison/venv-base/cage2_bridge/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export CL_SOURCE_REGISTRY='(:source-registry (:directory "/home/hardison/bes-artifacts/worktrees/structural-opportunity-audit/") :ignore-inherited-configuration)'
export AUDIT_CHECKPOINT="$checkpoint" AUDIT_ENVIRONMENT="$environment"
export AUDIT_SEED_ROOT="$seed_root" AUDIT_OUTPUT="$output/steps.tsv"
sha256sum "$checkpoint" "$repo/structural-opportunity-audit.lisp" \
  "$repo/scripts/select-response-sweep-groups.py" \
  "$repo/experiments/meander-v8-gap-screen.md" > "$output/input-sha256.txt"
cd "$repo"
/usr/bin/sbcl --dynamic-space-size 4096 --non-interactive \
  --eval '(require :asdf)' \
  --eval '(asdf:load-system :cl-tpg)' \
  --load official-counterfactual-pilot.lisp \
  --load structural-opportunity-audit.lisp \
  --eval '(cl-tpg::run-structural-opportunity-audit
            (uiop:getenv "AUDIT_CHECKPOINT")
            (uiop:getenv "AUDIT_OUTPUT")
            :seed-root (parse-integer (uiop:getenv "AUDIT_SEED_ROOT"))
            :environment-name (uiop:getenv "AUDIT_ENVIRONMENT"))'
python3 scripts/select-response-sweep-groups.py "$output" \
  --seed-root "$seed_root" > "$output/group-selection.stdout.json"
