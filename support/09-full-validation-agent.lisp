(in-package :cl-tpg)

(defun full-validation-expert-ranking (expert input)
  (let ((*instruction-set-profile* (dispatch-expert-instruction-profile expert))
        (*read-only-register-profile* (dispatch-expert-register-profile expert)))
    (execute-team-semantic-ranked (dispatch-expert-team expert) input)))

(defun full-validation-delivered-ranking (expert input controller route)
  (declare (ignore controller route))
  (full-validation-expert-ranking expert input))

(defun full-validation-agent-server (router-file bline-file meander-file)
  "Expose the frozen dispatch policy as a concrete-action agent for ChallengeWrapper."
  (let* ((*teams* nil)
         (*team-id-generator* (make-counter))
         (*learner-id-generator* (make-counter))
         (*num-observations* 62)
         (*num-actions* 36)
         (*factored-actions-enabled* t)
         (*terminal-action-format* :target-response-36)
         (*cage2-opening-mode* :fixed)
         (*decoy-order-mode* :fixed)
         (*cage2-decoy-resolution* :ranked-decoy-hosts)
         (*recurrent-policy-enabled* nil)
         (*policy-episode-registers* nil)
         (*hamming-space-enabled* nil)
         (router (load-post-opening-router router-file))
         (bline (load-dispatch-expert bline-file :bline-cardiff-global))
         (meander (load-dispatch-expert meander-file :meander-cardiff-global))
         (controller (make-cage2-controller :decoy-order-profile :heuristic))
         (expert nil)
         (pending nil))
    (labels ((reply (format-string &rest values)
               (write-string "AGENT " *standard-output*)
               (apply #'format *standard-output* format-string values)
               (terpri)
               (finish-output))
             (choose (raw)
               (assert (not pending))
               (assert (and (= (length raw) 52) (every (lambda (c) (find c "01")) raw)))
               (let* ((obs (map 'vector #'digit-char-p raw))
                      (input (cage2-controller-observe controller obs))
                      (step (cage2-controller-step controller))
                      (route (post-opening-route router controller input)))
                 (when (= step +post-opening-router-decision+)
                   (setf expert (ecase route (:b-line bline) (:meander meander) (:sleep nil)))
                   (when expert
                     (let ((template (dispatch-expert-controller-template expert)))
                       (setf (cage2-controller-decoy-order-profile controller)
                             (cage2-controller-decoy-order-profile template)
                             (cage2-controller-option-orders controller)
                             (cage2-controller-option-orders template)
                             (cage2-controller-decoy-schedule controller)
                             (cage2-controller-decoy-schedule template)))))
                 (multiple-value-bind (decision top)
                     (cond ((eq route :sleep) (values :sleep nil))
                           ((< step +post-opening-router-decision+)
                            (values (cage2-controller-resolve-pair-ranking
                                     controller (aref +cage2-fixed-opening-rankings+ step)) nil))
                           (t
                            (let ((ranking (full-validation-delivered-ranking expert input controller route)))
                              (values (cage2-controller-resolve-ranking controller ranking)
                                      (and (car ranking)
                                           (semantic-action-category-pair (car ranking)))))))
                   (setf pending decision)
                   (let ((label (if top (format nil "~D:~D" (first top) (second top)) "-")))
                     (reply "~D ~(~A~) ~A ~A"
                            (if (eq pending :sleep) 0
                                (cage2-controller-decision-concrete-action pending))
                            (or route :opening) label label)))))
             (commit (action)
               (assert pending)
               (if (eq pending :sleep)
                   (progn (assert (zerop action)) (incf (cage2-controller-step controller)))
                   (cage2-controller-commit-decision controller pending action))
               (setf pending nil)
               (reply "ok")))
      (reply "ready")
      (loop for line = (read-line *standard-input* nil) while line
            do (cond ((string= line "quit") (return))
                     ((string= line "reset")
                      (assert (not pending))
                      (setf controller (make-cage2-controller :decoy-order-profile :heuristic)
                            expert nil)
                      (reset-post-opening-router router)
                      (reply "ok"))
                     ((and (> (length line) 4) (string= "obs " line :end2 4))
                      (choose (subseq line 4)))
                     ((and (> (length line) 7) (string= "commit " line :end2 7))
                      (commit (parse-integer line :start 7)))
                     (t (error "Unexpected evaluation command ~S" line)))))))
