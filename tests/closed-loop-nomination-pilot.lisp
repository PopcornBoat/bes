(load (merge-pathnames "official-counterfactual-pilot.lisp" (asdf:system-source-directory :cl-tpg)))
(load (merge-pathnames "privileged-search.lisp" (asdf:system-source-directory :cl-tpg)))
(load (merge-pathnames "structural-opportunity-audit.lisp" (asdf:system-source-directory :cl-tpg)))
(load (merge-pathnames "closed-loop-nomination-pilot.lisp" (asdf:system-source-directory :cl-tpg)))
(in-package :cl-tpg)

(assert (eq :continue (nomination-screen-status '(-2 -1 -2 -1 -2) nil)))
(assert (eq :continue (nomination-screen-status '(-100 1 1 1 1) nil)))
(assert (eq :clear-severe-regression (nomination-screen-status '(-20 -20 -20 -20 -20) nil)))
(assert (eq :continue (nomination-screen-status '(-20) nil)))
(assert (eq :protected-host-regression
            (nomination-screen-status '(100 100 100 100 100) '(:violation))))
(assert (equal "b" (nomination-confirm-choice '("a" "b" "c")
                                              '(("a" . :clear-severe-regression)
                                                ("b" . :continue) ("c" . :continue)))))
(let* ((state (make-random-state *random-state*))
       (copy (make-random-state state))
       (*random-state* state))
  (assert (equal (nomination-random-order '(1 2 3 4 5 6) 153)
                 (nomination-random-order '(1 2 3 4 5 6) 153)))
  (assert (= (random 100000) (random 100000 copy))))

(let* ((*num-observations* 62) (*num-actions* 36)
       (*factored-actions-enabled* t) (*terminal-action-format* :target-response-36)
       (*instruction-set-profile* :reduced-eq) (*read-only-register-profile* :cage2-categorical-v1)
       (*recurrent-policy-enabled* nil)
       (learner (make-learner :program (incubation-gate-program '((0 0) (1 0)) 250.0d0)
                             :action (make-action :type :atomic
                                                  :action (make-target-response-36-action
                                                           :target 3 :response 0))))
       (parent (brute-canonicalize-ids (%make-team :learners (list learner))))
       (controller (make-cage2-controller :decoy-order-profile :meander-heuristic))
       (directory (pathname (format nil "/tmp/nomination-pilot-tests-~D/" (get-internal-real-time)))))
  (loop for seed from 1 to 3 do
    (let ((events
            (loop for step below 6 collect
              (let ((obs (make-array 62 :element-type 'double-float :initial-element 0.0d0)))
                (when (oddp step) (setf (aref obs 0) 1.0d0 (aref obs 1) 1.0d0))
                (list :step step :policy-observation obs :terminal-team (team-id parent)
                      :active-path (list (team-id parent)) :executed-pair '(3 0)
                      :ranking '((3 0)) :actual-concrete 4 :incumbent-concrete 4 :reward -1.0d0
                      :controller-before
                      (list :scan (make-list 10 :initial-element 0.0d0)
                            :decoy-mask 0 :step step))))))
      (write-readable-object-atomically
       (list :seed seed :return -6.0d0 :steps (coerce events 'vector))
       (merge-pathnames (format nil "~D-incumbent.sexp" seed) directory))))
  (multiple-value-bind (catalog contexts audit)
      (nomination-build-catalog parent controller directory 12345)
    (assert (> (length catalog) 4))
    (assert (= (length catalog) (getf audit :catalog-size)))
    (assert (= (getf audit :selected-groups) 2))
    (assert (equalp catalog (nomination-build-catalog parent controller directory 12345)))
    (let* ((lanes (nomination-select-lanes catalog 4 77))
           (first (first catalog))
           (spec (getf first :spec))
           (a (brute-canonicalize-ids (incubation-child parent spec)))
           (b (brute-canonicalize-ids (incubation-child parent spec))))
      (assert (= 3 (length lanes)))
      (dolist (lane lanes) (assert (= 4 (length (getf lane :nominations)))))
      (assert (equalp lanes (nomination-select-lanes catalog 4 77)))
      (assert (equalp (serialize-team a (make-hash-table :test #'equal))
                      (serialize-team b (make-hash-table :test #'equal))))
      (assert (= 1 (length (team-learners parent))))
      (assert (= 2 (length (team-learners a))))
      (assert (plusp (getf (nomination-probe parent a controller contexts) :actual-changes))))))
(format t "~&Closed-loop pilot generator, fair catalog, RNG isolation, activation and negative-filter checks passed.~%")

(let* ((safe (list :host "Op_Server0" :seed 1 :loss 0 :controlled-steps 0 :maximum-control-streak 0))
       (base (list :episodes (list (list :seed 1 :return -10.0d0 :safety safe))))
       (same (list :episodes (list (list :seed 1 :return -10.0d0 :safety safe))))
       (comparison (nomination-comparison same base)))
  (assert (not (getf comparison :positive-mean)))
  (assert (not (getf comparison :positive-exploratory-evidence)))
  (assert (eq :continue (getf comparison :screen-status)))
  (assert (handler-case
              (progn (nomination-comparison
                      '(:episodes ((:seed 2 :return -9))) base) nil)
            (error () t))))
(format t "~&Paired seed accounting and positive-evidence distinction checks passed.~%")
